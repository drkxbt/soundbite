[{"start":0.56,"end":2.32,"text":"Welcome back to the space.","words":[{"text":"Welcome","start":0.56,"end":0.86},{"text":"back","start":0.86,"end":1},{"text":"to","start":1,"end":1.16},{"text":"the","start":1.16,"end":1.58},{"text":"space.","start":1.58,"end":2.32}]},{"start":2.72,"end":5.78,"text":"Today we're talking about shipping in public.","words":[{"text":"Today","start":2.72,"end":2.94},{"text":"we're","start":2.94,"end":3.4},{"text":"talking","start":3.4,"end":3.74},{"text":"about","start":3.74,"end":4.04},{"text":"shipping","start":4.04,"end":4.3},{"text":"in","start":4.3,"end":4.64},{"text":"public.","start":4.72,"end":5.78}]},{"start":6.2,"end":11.46,"text":"The best thing I did this year was post every build, even the ugly ones.","words":[{"text":"The","start":6.2,"end":6.48},{"text":"best","start":6.48,"end":6.8},{"text":"thing","start":6.8,"end":6.9},{"text":"I","start":6.9,"end":7.04},{"text":"did","start":7.04,"end":7.3},{"text":"this","start":7.3,"end":7.48},{"text":"year","start":7.48,"end":7.7},{"text":"was","start":7.7,"end":8},{"text":"post","start":8,"end":8.32},{"text":"every","start":8.32,"end":8.64},{"text":"build,","start":8.64,"end":9.02},{"text":"even","start":9.26,"end":9.46},{"text":"the","start":9.46,"end":9.68},{"text":"ugly","start":9.68,"end":10},{"text":"ones.","start":10.14,"end":11.46}]},{"start":11.68,"end":15.32,"text":"Did people actually care about the ugly ones?","words":[{"text":"Did","start":11.68,"end":12.04},{"text":"people","start":12.04,"end":12.52},{"text":"actually","start":12.52,"end":12.82},{"text":"care","start":12.82,"end":13.14},{"text":"about","start":13.14,"end":13.3},{"text":"the","start":13.3,"end":13.54},{"text":"ugly","start":13.54,"end":13.84},{"text":"ones?","start":14,"end":15.32}]},{"start":15.56,"end":17.46,"text":"More than the polished ones.","words":[{"text":"More","start":15.56,"end":15.8},{"text":"than","start":15.8,"end":15.96},{"text":"the","start":15.96,"end":16.22},{"text":"polished","start":16.22,"end":16.76},{"text":"ones.","start":16.76,"end":17.46}]},{"start":17.72,"end":21.6,"text":"They could see the work, so they trusted the result.","words":[{"text":"They","start":17.72,"end":17.96},{"text":"could","start":17.96,"end":18.12},{"text":"see","start":18.12,"end":18.34},{"text":"the","start":18.34,"end":18.62},{"text":"work,","start":18.62,"end":19.18},{"text":"so","start":19.22,"end":19.42},{"text":"they","start":19.42,"end":19.74},{"text":"trusted","start":19.74,"end":20.02},{"text":"the","start":20.02,"end":20.24},{"text":"result.","start":20.38,"end":21.6}]},{"start":21.98,"end":27.3,"text":"So the advice is ship small, ship often, and show your work.","words":[{"text":"So","start":21.98,"end":22.18},{"text":"the","start":22.18,"end":22.46},{"text":"advice","start":22.46,"end":22.72},{"text":"is","start":22.72,"end":22.94},{"text":"ship","start":22.94,"end":23.36},{"text":"small,","start":23.36,"end":23.88},{"text":"ship","start":24.12,"end":24.5},{"text":"often,","start":24.5,"end":24.98},{"text":"and","start":25.22,"end":25.4},{"text":"show","start":25.4,"end":25.68},{"text":"your","start":25.68,"end":26.08},{"text":"work.","start":26.08,"end":27.3}]},{"start":27.54,"end":29.96,"text":"And reply to everyone who tries it.","words":[{"text":"And","start":27.54,"end":27.82},{"text":"reply","start":27.82,"end":28.06},{"text":"to","start":28.06,"end":28.38},{"text":"everyone","start":28.38,"end":28.7},{"text":"who","start":28.7,"end":28.92},{"text":"tries","start":28.92,"end":29.48},{"text":"it.","start":29.48,"end":29.96}]},{"start":30.22,"end":33.16,"text":"That's where the next idea comes from.","words":[{"text":"That's","start":30.22,"end":30.46},{"text":"where","start":30.46,"end":30.58},{"text":"the","start":30.58,"end":30.86},{"text":"next","start":30.86,"end":31.18},{"text":"idea","start":31.18,"end":31.52},{"text":"comes","start":31.52,"end":31.96},{"text":"from.","start":31.98,"end":33.16}]}]
