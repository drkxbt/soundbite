{
  "name": "soundbite",
  "version": "0.15.0",
  "private": true,
  "description": "Turn the best minute of a Space or a podcast into a captioned video for X, TikTok, Reels, Shorts or LinkedIn, in the browser: the words are transcribed and timed on your device, and nothing is uploaded.",
  "license": "MIT",
  "author": "drk",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && node build.js",
    "test": "tsc -p tsconfig.json && node --test \"test/*.test.js\"",
    "demo": "npm run build && node demo/serve.js"
  },
