{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "declaration": true,
    "sourceMap": true,
    "rootDir": ".",
    "outDir": "dist",
    "skipLibCheck": true
  },
  "include": [
    "index.ts",
    "audio.ts",
    "cues.ts",
    "transcribe.ts",
    "transcribe-worker.ts",
    "kit.ts",
    "credit.ts",
    "ads.ts",
    "config.ts",
    "app.ts",
    "panel.ts",
    "failures.ts",
    "sweep.ts",
    "fonts.ts"
  ]
}
